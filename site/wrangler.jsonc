{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genisland-ai-center",
  "main": "./src/server.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/assets/films/*"]
  }
}
